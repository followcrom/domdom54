# Canonical line endings.
#
# Everything git detects as text is stored LF in the repository AND checked out
# LF in the working tree. This is deliberate: EAS builds on Linux, Metro and the
# Gradle wrapper are LF-native, and pinning both ends means CRLF can never enter
# the history regardless of each machine's core.autocrlf setting.
*                text=auto eol=lf

# Windows batch files genuinely require CRLF to execute.
*.bat            text eol=crlf
*.cmd            text eol=crlf

# Binary — never normalise, never diff as text.
*.png            binary
*.jpg            binary
*.jpeg           binary
*.webp           binary
*.gif            binary
*.ico            binary
*.mp3            binary
*.wav            binary
*.m4a            binary
*.aac            binary
*.ttf            binary
*.otf            binary
*.woff           binary
*.woff2          binary
*.zip            binary
*.aab            binary
*.apk            binary
*.jks            binary
*.keystore       binary
*.p12            binary
*.p8             binary

# Generated — collapse in diffs and hide from language stats.
package-lock.json  linguist-generated=true -diff
